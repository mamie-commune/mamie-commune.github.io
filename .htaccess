# Réglages du serveur IONOS (Apache) pour mamiecommune.org. GitHub Pages n'en tient pas compte.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Toujours en HTTPS, et toujours sur mamiecommune.org (sans www).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^mamiecommune\.org$ [NC]
  RewriteCond %{HTTP_HOST} mamiecommune\.org$ [NC]
  RewriteRule ^ https://mamiecommune.org%{REQUEST_URI} [L,R=301]

  # Anciennes adresses : l'ancienne page « Partage de données » est remplacée par le guide Signal.
  RewriteRule ^partage(\.html)?$ /guides/signal [L,R=301]
  RewriteRule ^manif/legal-team-belgique(\.html)?$ /manif/legal-team [L,R=301]
  # Guides retirés (octobre 2026) : renvoi vers la liste des guides.
  RewriteRule ^guides/(distribution-gnu-linux|manuel-mint|personnaliser-mint|depannage-mises-a-jour|mises-a-jour|raccourcis-clavier|raccourcis-clavier-detail|linux-pour-debutants|deja-linux|pourquoi-changer|liberer-windows|acheter-un-ordinateur|obtenir-de-l-aide|fin-de-windows-10|youtube-sans-pub|quitter-facebook|blokada|libreoffice|choisir-un-service|ressources-associations|flux-rss)(\.html)?$ /guides/ [L,R=301]

  # Adresses propres : /page.html → /page et /dossier/index.html → /dossier/ (redirection permanente)…
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]
  # … et /page sert le fichier page.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Types de fichiers
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg
AddType video/mp4 .mp4
AddType application/pdf .pdf
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js

# Les pages sont revérifiées à chaque visite ; images, polices et PDF gardés un mois dans le navigateur.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # Styles et scripts : leur adresse change à chaque version (?v=…), on peut donc les garder un an.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
